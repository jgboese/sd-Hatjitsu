{
  "name": "hatjitsu",
  "version": "0.1.0",
  "private": true,
  "description": "Disposable online planning poker rooms",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server/index.ts",
    "dev": "concurrently --kill-others --names server,client \"node --watch server/index.ts\" vite",
    "build": "vite build",
    "ci": "yarn typecheck && yarn format:check && yarn eslint && yarn stylelint && yarn test && yarn build",
    "typecheck": "node node_modules/typescript7/bin/tsc && node node_modules/typescript7/bin/tsc -p client",
    "eslint": "eslint --color .",
    "eslint:fix": "eslint --color . --fix --quiet --cache",
    "stylelint": "stylelint 'client/**/*.css'",
    "stylelint:fix": "stylelint 'client/**/*.css' --fix",
    "format": "prettier --log-level=warn --write .",
    "format:check": "prettier --log-level=warn --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "knip": "knip",
    "postinstall": "is-ci || husky"
  },
  "engines": {
    "node": "24.22"
  },
  "packageManager": "yarn@4.18.1",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --color --no-warn-ignored"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "client/**/*.css": [
      "stylelint --allow-empty-input"
    ]
  },
  "dependencies": {
    "compression": "1.8.2",
    "express": "5.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.3.15",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "socket.io-client": "4.8.4",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
